{
  "name": "xamvaad",
  "version": "0.1.0",
  "private": true,
  "description": "Xamvaad — Where Aspirants Discuss. Structured discussion platform for competitive exam aspirants.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg.ps1 setup",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg.ps1 stop",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg.ps1 status",
    "db:psql": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg.ps1 psql",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "make-admin": "tsx --env-file=.env scripts/make-admin.ts",
    "build-icons": "tsx scripts/build-icons.ts"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.474.0",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
