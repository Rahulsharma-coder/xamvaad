# ---------------------------------------------------------------------------
# Xamvaad — environment configuration
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local Docker (see docker-compose.yml):
DATABASE_URL="postgresql://xamvaad:xamvaad@localhost:5432/xamvaad?schema=public"
# Hosted (Neon / Supabase / Railway) — remember ?sslmode=require
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used for OAuth redirect URIs).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
# Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Official Updates from the Sarkari Result feed (.github/workflows/official-feed.yml).
# The workflow sends this as a bearer token; the same value goes in the
# repository's CRON_SECRET secret. Unset means the feed endpoint refuses.
CRON_SECRET=""
# Admin username the updates are published under. Defaults to the oldest admin.
OFFICIAL_FEED_AUTHOR=""
